}

model LeaveBalanceTransaction {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  balanceId   String   @db.Char(36)
  // OPENING, ACCRUAL, RESERVE, RELEASE, USAGE, ADJUSTMENT, CARRY_FORWARD, CANCELLATION_RESTORE, EXPIRY
  type        String   @db.VarChar(30)
  days        Decimal  @db.Decimal(8, 2)
  refType     String?  @db.VarChar(40)
  refId       String?  @db.Char(36)
  note        String?  @db.VarChar(500)
  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())

  balance LeaveBalance @relation(fields: [balanceId], references: [id])

  @@index([balanceId])
  @@map("leave_balance_transactions")
}

model LeaveRequest {
  id                 String    @id @default(uuid()) @db.Char(36)
  companyId          String    @db.Char(36)
  employeeId         String    @db.Char(36)
  leaveTypeId        String    @db.Char(36)
  policyId           String?   @db.Char(36)
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  halfDay            Boolean   @default(false)
  days               Decimal   @db.Decimal(8, 2)
  reason             String?   @db.VarChar(1000)
  attachmentId       String?   @db.Char(36)
  emergencyContact   String?   @db.VarChar(200)
  handoverNotes      String?   @db.VarChar(1000)
  // DRAFT, SUBMITTED, PENDING_MANAGER, PENDING_HR, APPROVED, REJECTED, CANCELLED, WITHDRAWN, CANCELLATION_PENDING
  status             String    @default("DRAFT") @db.VarChar(30)
  approvalInstanceId String?   @db.Char(36)
  submittedAt        DateTime?
  decidedAt          DateTime?
  cancelReason       String?   @db.VarChar(500)
  createdById        String?   @db.Char(36)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee  Employee     @relation(fields: [employeeId], references: [id])
  leaveType LeaveType    @relation(fields: [leaveTypeId], references: [id])
  policy    LeavePolicy? @relation(fields: [policyId], references: [id])

  @@index([companyId, status])
  @@index([companyId, startDate, endDate])
  @@index([employeeId, startDate])
  @@map("leave_requests")
}

// ───────────────────────────── Approvals (generic) ─────────────────────────────

model ApprovalWorkflow {
  id         String   @id @default(uuid()) @db.Char(36)
  companyId  String   @db.Char(36)
  code       String   @db.VarChar(60)
  name       String   @db.VarChar(150)
  // LEAVE, LEAVE_CANCELLATION, ATTENDANCE_CORRECTION, SHIFT_EXCHANGE, ADVANCE, LOAN, PAYROLL, SALARY_CHANGE, OVERTIME
  entityType String   @db.VarChar(40)
  isDefault  Boolean  @default(false)
  priority   Int      @default(0) // higher wins when several match
  // { minAmount, maxAmount, branchIds[], leaveTypeIds[] }
  conditions Json?
  status     String   @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  steps     ApprovalStep[]
  instances ApprovalInstance[]

  @@unique([companyId, code])
  @@index([companyId, entityType])
  @@map("approval_workflows")
}

model ApprovalStep {
  id           String  @id @default(uuid()) @db.Char(36)
  workflowId   String  @db.Char(36)
  stepOrder    Int
  name         String  @db.VarChar(150)
  // DIRECT_MANAGER, DEPARTMENT_MANAGER, BRANCH_MANAGER, ROLE, USER
  approverType String  @db.VarChar(30)
  roleCode     String? @db.VarChar(60)
  userId       String? @db.Char(36)
  // ANY = first approver decides (parallel pool), ALL = every resolved approver must approve (parallel approval)
  mode         String  @default("ANY") @db.VarChar(10)
  // conditional step, e.g. { minAmount: 5000 } → only when request amount >= 5000
  condition    Json?
  // status label shown on the request while this step is pending (e.g. PENDING_MANAGER, PENDING_HR)
  pendingStatus String? @db.VarChar(30)

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@map("approval_steps")
}

model ApprovalInstance {
  id                  String    @id @default(uuid()) @db.Char(36)
  companyId           String    @db.Char(36)
  workflowId          String    @db.Char(36)
  entityType          String    @db.VarChar(40)
  entityId            String    @db.Char(36)
  requesterUserId     String?   @db.Char(36)
  requesterEmployeeId String?   @db.Char(36)
  amount              Decimal?  @db.Decimal(14, 2)
  status              String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED, CANCELLED
  currentStep         Int       @default(1)
  summary             String?   @db.VarChar(300)
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  tasks    ApprovalTask[]

  @@index([companyId, entityType, entityId])
  @@index([companyId, status])
  @@map("approval_instances")
}

model ApprovalTask {
  id             String    @id @default(uuid()) @db.Char(36)
  instanceId     String    @db.Char(36)
  stepOrder      Int
  stepName       String    @db.VarChar(150)
  mode           String    @default("ANY") @db.VarChar(10)
  approverUserId String?   @db.Char(36)
  // WAITING (future step), PENDING, APPROVED, REJECTED, SKIPPED, CLOSED (another approver in an ANY pool decided)
  status         String    @default("WAITING") @db.VarChar(20)
  comment        String?   @db.VarChar(1000)
  actedAt        DateTime?
  createdAt      DateTime  @default(now())

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([approverUserId, status])
  @@index([instanceId])
  @@map("approval_tasks")
}

// ───────────────────────────── Payroll ─────────────────────────────

model PayrollSetting {
  id                       String   @id @default(uuid()) @db.Char(36)
  companyId                String   @unique @db.Char(36)
  frequency                String   @default("MONTHLY") @db.VarChar(20) // MONTHLY, WEEKLY, BIWEEKLY, CUSTOM
  cutoffDay                Int      @default(25)
  paymentDay               Int      @default(27)
  // CALENDAR = actual days in period, FIXED = fixedDaysPerMonth
  daysBasis                String   @default("FIXED") @db.VarChar(20)
  fixedDaysPerMonth        Int      @default(30)
  standardDailyHours       Decimal  @default(8) @db.Decimal(5, 2)
  overtimeBase             String   @default("BASIC") @db.VarChar(30) // BASIC, FLAGGED_COMPONENTS
  overtimeRateWeekday      Decimal  @default(1.5) @db.Decimal(6, 3)
  overtimeRateWeekend      Decimal  @default(1.5) @db.Decimal(6, 3)
  overtimeRateHoliday      Decimal  @default(1.5) @db.Decimal(6, 3)
  absenceDeductionEnabled  Boolean  @default(true)
  absenceDeductionBase     String   @default("FLAGGED_COMPONENTS") @db.VarChar(30) // BASIC, FLAGGED_COMPONENTS
  lateDeductionMode        String   @default("NONE") @db.VarChar(20) // NONE, PER_MINUTE
  lateFreeMinutesPerPeriod Int      @default(0)
  earlyLeaveDeduction      Boolean  @default(false)
  unpaidLeaveDeduction     Boolean  @default(true)
  roundingDecimals         Int      @default(2)
  roundingMode             String   @default("HALF_UP") @db.VarChar(20) // HALF_UP, DOWN, UP
  maxDeductionPercent      Decimal? @db.Decimal(5, 2) // cap on loan/advance installments as % of gross; null = no cap
  gosiEmployeeRate         Decimal  @default(0) @db.Decimal(6, 3)
  gosiEmployerRate         Decimal  @default(0) @db.Decimal(6, 3)
  gosiNationalities        Json?    // e.g. ["SA"]; null = all employees flagged gosiApplicable
  commissionInclusion      String   @default("APPROVED_BY_PERIOD_END") @db.VarChar(40)
  bankExportFormat         Json?    // ordered column definitions for bank transfer file
  workflowId               String?  @db.Char(36)
  // End-of-service rules are company-configured; empty array means the amount is entered manually at settlement
  eosRules                 Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("payroll_settings")
}

model SalaryComponent {
  id                    String    @id @default(uuid()) @db.Char(36)
