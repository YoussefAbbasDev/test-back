  minRequestDays           Decimal?  @db.Decimal(8, 2)
  maxRequestDays           Decimal?  @db.Decimal(8, 2)
  attachmentRequired       Boolean   @default(false)
  attachmentAfterDays      Decimal?  @db.Decimal(8, 2)
  countWeekends            Boolean   @default(false)
  countHolidays            Boolean   @default(false)
  requiresBalance          Boolean   @default(true)
  allowNegativeBalance     Boolean   @default(false)
