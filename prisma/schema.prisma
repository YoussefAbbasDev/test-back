  applicableEmploymentTypes Json?
  allowCancellationAfterStart Boolean @default(false)
  workflowId               String?   @db.Char(36)
  effectiveFrom            DateTime  @db.Date
  effectiveTo              DateTime? @db.Date
  status                   String    @default("ACTIVE") @db.VarChar(20)
