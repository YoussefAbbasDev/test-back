  periodId           String    @db.Char(36)
  branchId           String?   @db.Char(36) // null = all branches
  runNumber          String    @db.VarChar(40)
  type               String    @default("REGULAR") @db.VarChar(20) // REGULAR, OFF_CYCLE, REVERSAL
  // DRAFT, CALCULATED, IN_REVIEW, APPROVED, LOCKED, PAID, PARTIALLY_PAID, REVERSED, CANCELLED
  status             String    @default("DRAFT") @db.VarChar(20)
  employeeFilter     Json?     // { employeeIds?, departmentIds? }
  employeesCount     Int       @default(0)
  totalBasic         Decimal   @default(0) @db.Decimal(16, 2)
  totalEarnings      Decimal   @default(0) @db.Decimal(16, 2)
  totalDeductions    Decimal   @default(0) @db.Decimal(16, 2)
  totalOvertime      Decimal   @default(0) @db.Decimal(16, 2)
  totalCommissions   Decimal   @default(0) @db.Decimal(16, 2)
  totalNet           Decimal   @default(0) @db.Decimal(16, 2)
  currency           String    @default("SAR") @db.VarChar(3)
  approvalInstanceId String?   @db.Char(36)
  reversalOfId       String?   @db.Char(36)
  calculatedAt       DateTime?
  approvedAt         DateTime?
  lockedAt           DateTime?
  createdById        String?   @db.Char(36)
  notes              String?   @db.VarChar(1000)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  period    PayrollPeriod        @relation(fields: [periodId], references: [id])
  employees PayrollRunEmployee[]
  payments  PayrollPayment[]

  @@unique([companyId, runNumber])
  @@index([companyId, status])
  @@map("payroll_runs")
}

model PayrollRunEmployee {
  id               String    @id @default(uuid()) @db.Char(36)
  companyId        String    @db.Char(36)
  runId            String    @db.Char(36)
  employeeId       String    @db.Char(36)
  // Snapshot of identity fields at calculation time so locked history never changes when the profile changes
  snapshot         Json
  status           String    @default("INCLUDED") @db.VarChar(20) // INCLUDED, EXCLUDED, ON_HOLD
  excludeReason    String?   @db.VarChar(500)
  periodDays       Decimal   @default(0) @db.Decimal(8, 2)
  paidDays         Decimal   @default(0) @db.Decimal(8, 2)
  absentDays       Decimal   @default(0) @db.Decimal(8, 2)
  unpaidLeaveDays  Decimal   @default(0) @db.Decimal(8, 2)
  lateMinutes      Int       @default(0)
  overtimeMinutes  Int       @default(0)
  basicSalary      Decimal   @default(0) @db.Decimal(14, 2)
  grossEarnings    Decimal   @default(0) @db.Decimal(14, 2)
  totalDeductions  Decimal   @default(0) @db.Decimal(14, 2)
  netSalary        Decimal   @default(0) @db.Decimal(14, 2)
  warnings         Json?
  errors           Json?
  paymentStatus    String    @default("UNPAID") @db.VarChar(20) // UNPAID, PAID, FAILED
  paymentReference String?   @db.VarChar(120)
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  run      PayrollRun    @relation(fields: [runId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayrollLine[]
  payslip  Payslip?

  @@unique([runId, employeeId])
  @@index([companyId, employeeId])
  @@map("payroll_run_employees")
}

// Earnings and deductions of a run (spec tables payroll_earnings / payroll_deductions unified with a type column)
model PayrollLine {
  id             String   @id @default(uuid()) @db.Char(36)
  runEmployeeId  String   @db.Char(36)
  componentId    String?  @db.Char(36)
  code           String   @db.VarChar(40)
  nameAr         String   @db.VarChar(150)
  nameEn         String   @db.VarChar(150)
  type           String   @db.VarChar(20) // EARNING, DEDUCTION
  category       String   @db.VarChar(30)
  quantity       Decimal? @db.Decimal(12, 4)
  rate           Decimal? @db.Decimal(14, 4)
  amount         Decimal  @db.Decimal(14, 2)
  // SALARY, STRUCTURE, ATTENDANCE, LEAVE, COMMISSION, ADVANCE, LOAN, ADJUSTMENT, STATUTORY
  sourceType     String   @db.VarChar(30)
  sourceId       String?  @db.Char(36)
  meta           Json?
  sortOrder      Int      @default(0)

  runEmployee PayrollRunEmployee @relation(fields: [runEmployeeId], references: [id], onDelete: Cascade)

  @@index([runEmployeeId])
  @@index([sourceType, sourceId])
  @@map("payroll_lines")
}

model PayrollAdjustment {
  id            String    @id @default(uuid()) @db.Char(36)
  companyId     String    @db.Char(36)
  employeeId    String    @db.Char(36)
  componentId   String?   @db.Char(36)
  type          String    @db.VarChar(20) // EARNING, DEDUCTION
  category      String    @default("OTHER_EARNING") @db.VarChar(30)
  amount        Decimal   @db.Decimal(14, 2)
  effectiveDate DateTime  @db.Date
  reason        String    @db.VarChar(500)
  originalRunId String?   @db.Char(36) // when correcting a locked run
  appliedRunId  String?   @db.Char(36)
  status        String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, APPLIED, CANCELLED
  createdById   String?   @db.Char(36)
  approvedById  String?   @db.Char(36)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, status])
  @@map("payroll_adjustments")
}

model PayrollPayment {
  id            String   @id @default(uuid()) @db.Char(36)
  companyId     String   @db.Char(36)
  runId         String   @db.Char(36)
  runEmployeeId String   @db.Char(36)
  amount        Decimal  @db.Decimal(14, 2)
  method        String   @db.VarChar(20)
  bankName      String?  @db.VarChar(120)
  iban          String?  @db.VarChar(34)
  reference     String?  @db.VarChar(120)
  paidAt        DateTime
  status        String   @default("PAID") @db.VarChar(20) // PAID, FAILED
  recordedById  String?  @db.Char(36)
  createdAt     DateTime @default(now())

  run PayrollRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@map("payroll_payments")
}

// ───────────────────────────── Payslips ─────────────────────────────

// Items are the locked PayrollLine rows of the linked run employee (immutable after lock), so no duplicate item table.
model Payslip {
  id            String    @id @default(uuid()) @db.Char(36)
  companyId     String    @db.Char(36)
  runEmployeeId String    @unique @db.Char(36)
  runId         String    @db.Char(36)
  employeeId    String    @db.Char(36)
  number        String    @db.VarChar(40)
  periodStart   DateTime  @db.Date
  periodEnd     DateTime  @db.Date
  paymentDate   DateTime  @db.Date
  grossEarnings Decimal   @db.Decimal(14, 2)
  totalDeductions Decimal @db.Decimal(14, 2)
  netSalary     Decimal   @db.Decimal(14, 2)
  currency      String    @db.VarChar(3)
  status        String    @default("ISSUED") @db.VarChar(20) // ISSUED, PAID, VOID
  issuedAt      DateTime  @default(now())

  runEmployee PayrollRunEmployee   @relation(fields: [runEmployeeId], references: [id])
  employee    Employee             @relation(fields: [employeeId], references: [id])
  downloads   PayslipDownloadLog[]

  @@unique([companyId, number])
  @@index([companyId, employeeId, periodStart])
  @@map("payslips")
}

model PayslipDownloadLog {
  id        String   @id @default(uuid()) @db.Char(36)
  payslipId String   @db.Char(36)
  userId    String   @db.Char(36)
  format    String   @db.VarChar(10)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  payslip Payslip @relation(fields: [payslipId], references: [id])

  @@index([payslipId])
  @@map("payslip_download_logs")
}

// ───────────────────────────── Commissions ─────────────────────────────

model CommissionRule {
  id                 String    @id @default(uuid()) @db.Char(36)
  companyId          String    @db.Char(36)
  code               String    @db.VarChar(40)
  nameAr             String    @db.VarChar(150)
  nameEn             String    @db.VarChar(150)
  // FIXED_PER_SERVICE, PERCENT_SALES, PERCENT_COLLECTED, PERCENT_NET_PROFIT, PER_TASK, TARGET, TIERED,
  // TEAM, SUPERVISOR, BRANCH_MANAGER, MONTHLY_BONUS, PERFORMANCE_BONUS
  type               String    @db.VarChar(30)
  // SALES_AMOUNT, COLLECTED_AMOUNT, NET_PROFIT, TASK_COUNT, FIXED
  calculationBase    String    @db.VarChar(30)
  value              Decimal   @default(0) @db.Decimal(14, 4) // % for percentage types, amount for fixed types
  tierMode           String?   @db.VarChar(20) // WHOLE_AMOUNT, INCREMENTAL (required for TIERED)
  minTarget          Decimal?  @db.Decimal(14, 2)
  maxTarget          Decimal?  @db.Decimal(14, 2)
  maxCommission      Decimal?  @db.Decimal(14, 2)
  employeeIds        Json?
  positionIds        Json?
  departmentIds      Json?
  branchIds          Json?
  serviceCategory    String?   @db.VarChar(100)
  serviceCode        String?   @db.VarChar(100)
  // Eligibility: { requireCompleted, requireQuality, requireInvoice, requireCollection, excludeCancelled, excludeRefunded, requireActiveEmployee }
  conditions         Json?
  requiresApproval   Boolean   @default(true)
  // participant role this rule pays (TECHNICIAN, SALES, SUPERVISOR, ANY)
  participantRole    String    @default("ANY") @db.VarChar(30)
  effectiveFrom      DateTime  @db.Date
  expiryDate         DateTime? @db.Date
  priority           Int       @default(0)
  status             String    @default("ACTIVE") @db.VarChar(20)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tiers        CommissionTier[]
  transactions CommissionTransaction[]

  @@unique([companyId, code])
  @@map("commission_rules")
}

model CommissionTier {
  id         String   @id @default(uuid()) @db.Char(36)
  ruleId     String   @db.Char(36)
  fromAmount Decimal  @db.Decimal(14, 2)
  toAmount   Decimal? @db.Decimal(14, 2)
  rate       Decimal  @db.Decimal(9, 4) // percent

  rule CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("commission_tiers")
}

// Business transaction (sale / service job / invoice) commissions are calculated from, pushed by SEEDA ERP or entered manually
model CommissionSourceTransaction {
  id               String    @id @default(uuid()) @db.Char(36)
  companyId        String    @db.Char(36)
  branchId         String?   @db.Char(36)
  sourceSystem     String    @default("MANUAL") @db.VarChar(30)
  externalRef      String    @db.VarChar(120)
  transactionDate  DateTime  @db.Date
  serviceCategory  String?   @db.VarChar(100)
  serviceCode      String?   @db.VarChar(100)
  serviceName      String?   @db.VarChar(200)
  salesAmount      Decimal   @default(0) @db.Decimal(14, 2)
  collectedAmount  Decimal   @default(0) @db.Decimal(14, 2)
  netProfit        Decimal   @default(0) @db.Decimal(14, 2)
  taskCount        Int       @default(1)
  isCompleted      Boolean   @default(true)
  qualityApproved  Boolean   @default(false)
  invoiceIssued    Boolean   @default(false)
  invoiceCollected Boolean   @default(false)
  isCancelled      Boolean   @default(false)
  isRefunded       Boolean   @default(false)
  status           String    @default("OPEN") @db.VarChar(20) // OPEN, PROCESSED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  participants CommissionParticipant[]

  @@unique([companyId, externalRef])
  @@index([companyId, transactionDate])
  @@map("commission_source_transactions")
}

// Distribution of a source transaction across employees (commission_distributions)
model CommissionParticipant {
  id            String  @id @default(uuid()) @db.Char(36)
  transactionId String  @db.Char(36)
  employeeId    String  @db.Char(36)
  role          String  @default("TECHNICIAN") @db.VarChar(30)
  sharePercent  Decimal @db.Decimal(7, 4)

  transaction CommissionSourceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  employee    Employee                    @relation(fields: [employeeId], references: [id])

  @@unique([transactionId, employeeId, role])
  @@map("commission_distributions")
}

// Commission ledger: entries are never edited in place; corrections are ADJUSTMENT / REVERSAL entries
model CommissionTransaction {
  id                  String    @id @default(uuid()) @db.Char(36)
  companyId           String    @db.Char(36)
  employeeId          String    @db.Char(36)
  ruleId              String?   @db.Char(36)
  sourceTransactionId String?   @db.Char(36)
  branchId            String?   @db.Char(36)
  serviceCode         String?   @db.VarChar(100)
  periodKey           String?   @db.VarChar(10) // YYYY-MM for target / tiered / monthly rules
  entryType           String    @default("ACCRUAL") @db.VarChar(20) // ACCRUAL, ADJUSTMENT, REVERSAL
  calculationBase     Decimal   @default(0) @db.Decimal(14, 2)
  rate                Decimal?  @db.Decimal(9, 4)
  sharePercent        Decimal   @default(100) @db.Decimal(7, 4)
  grossAmount         Decimal   @db.Decimal(14, 2)
  adjustments         Decimal   @default(0) @db.Decimal(14, 2)
  netAmount           Decimal   @db.Decimal(14, 2)
  // DRAFT, CALCULATED, PENDING_APPROVAL, APPROVED, ON_HOLD, PAYABLE, INCLUDED_IN_PAYROLL, PAID, REVERSED, CANCELLED
  status              String    @default("CALCULATED") @db.VarChar(30)
  dedupeKey           String?   @db.VarChar(191)
  reversalOfId        String?   @db.Char(36)
  payrollRunId        String?   @db.Char(36)
  approvedById        String?   @db.Char(36)
  approvedAt          DateTime?
  holdReason          String?   @db.VarChar(500)
  notes               String?   @db.VarChar(1000)
  earnedDate          DateTime  @db.Date
  createdById         String?   @db.Char(36)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee Employee        @relation(fields: [employeeId], references: [id])
  rule     CommissionRule? @relation(fields: [ruleId], references: [id])

  @@unique([companyId, dedupeKey])
  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("commission_transactions")
}

// ───────────────────────────── Advances & Loans ─────────────────────────────

model EmployeeAdvance {
  id                   String    @id @default(uuid()) @db.Char(36)
  companyId            String    @db.Char(36)
  employeeId           String    @db.Char(36)
  number               String    @db.VarChar(40)
  requestDate          DateTime  @db.Date
  amount               Decimal   @db.Decimal(14, 2)
  approvedAmount       Decimal?  @db.Decimal(14, 2)
  reason               String?   @db.VarChar(1000)
  requestedPaymentDate DateTime? @db.Date
  attachmentId         String?   @db.Char(36)
  repaymentMethod      String    @default("PAYROLL") @db.VarChar(20) // PAYROLL, MANUAL
  installmentCount     Int       @default(1)
  firstDeductionDate   DateTime? @db.Date
  notes                String?   @db.VarChar(1000)
  // DRAFT, PENDING, APPROVED, REJECTED, DISBURSED, REPAYING, SETTLED, CANCELLED
  status               String    @default("PENDING") @db.VarChar(20)
  approvalInstanceId   String?   @db.Char(36)
  disbursedAt          DateTime?
  createdById          String?   @db.Char(36)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id])
  installments Installment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("employee_advances")
}

model EmployeeLoan {
  id                 String    @id @default(uuid()) @db.Char(36)
  companyId          String    @db.Char(36)
  employeeId         String    @db.Char(36)
  number             String    @db.VarChar(40)
  loanType           String    @default("PERSONAL") @db.VarChar(30)
  amount             Decimal   @db.Decimal(14, 2)
  approvedAmount     Decimal?  @db.Decimal(14, 2)
  feeAmount          Decimal   @default(0) @db.Decimal(14, 2) // only when configured & legally permitted
  reason             String?   @db.VarChar(1000)
  requestDate        DateTime  @db.Date
  approvalDate       DateTime? @db.Date
  disbursementDate   DateTime? @db.Date
  installmentCount   Int
  monthlyInstallment Decimal?  @db.Decimal(14, 2)
  firstDeductionDate DateTime? @db.Date
  repaymentMethod    String    @default("PAYROLL") @db.VarChar(20)
  attachmentId       String?   @db.Char(36)
  status             String    @default("PENDING") @db.VarChar(20)
  approvalInstanceId String?   @db.Char(36)
  createdById        String?   @db.Char(36)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id])
  installments Installment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("employee_loans")
}

// loan_installments (also used for advance repayment schedules)
model Installment {
  id           String    @id @default(uuid()) @db.Char(36)
  companyId    String    @db.Char(36)
  employeeId   String    @db.Char(36)
  advanceId    String?   @db.Char(36)
  loanId       String?   @db.Char(36)
  number       Int
  dueDate      DateTime  @db.Date
  amount       Decimal   @db.Decimal(14, 2)
  paidAmount   Decimal   @default(0) @db.Decimal(14, 2)
  // UPCOMING, DUE, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED, DEFERRED
  status       String    @default("UPCOMING") @db.VarChar(20)
  deferredToId String?   @db.Char(36)
  notes        String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id])
  advance  EmployeeAdvance? @relation(fields: [advanceId], references: [id])
  loan     EmployeeLoan?    @relation(fields: [loanId], references: [id])

  @@index([companyId, employeeId, dueDate])
  @@index([advanceId])
  @@index([loanId])
  @@map("loan_installments")
}

model FinancialLedgerEntry {
  id            String   @id @default(uuid()) @db.Char(36)
  companyId     String   @db.Char(36)
  employeeId    String   @db.Char(36)
  advanceId     String?  @db.Char(36)
  loanId        String?  @db.Char(36)
  installmentId String?  @db.Char(36)
  // OPENING, DISBURSEMENT, INSTALLMENT_DEDUCTION, MANUAL_REPAYMENT, ADJUSTMENT, REVERSAL, SETTLEMENT
  type          String   @db.VarChar(30)
  debit         Decimal  @default(0) @db.Decimal(14, 2) // increases employee liability
  credit        Decimal  @default(0) @db.Decimal(14, 2) // reduces employee liability
  balanceAfter  Decimal  @db.Decimal(14, 2)             // running balance of that advance/loan
  payrollRunId  String?  @db.Char(36)
  reversalOfId  String?  @db.Char(36)
  note          String?  @db.VarChar(500)
  createdById   String?  @db.Char(36)
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, employeeId, createdAt])
  @@index([advanceId])
  @@index([loanId])
  @@map("employee_financial_ledger")
}

model EmployeeSettlement {
  id                 String    @id @default(uuid()) @db.Char(36)
  companyId          String    @db.Char(36)
  employeeId         String    @db.Char(36)
  terminationDate    DateTime  @db.Date
  reason             String?   @db.VarChar(500)
  outstandingBalance Decimal   @default(0) @db.Decimal(14, 2)
  unpaidInstallments Int       @default(0)
  eosAmount          Decimal   @default(0) @db.Decimal(14, 2)
  leaveEncashment    Decimal   @default(0) @db.Decimal(14, 2)
  otherDues          Decimal   @default(0) @db.Decimal(14, 2)
  agreedDeduction    Decimal   @default(0) @db.Decimal(14, 2) // only after policy/legal review
  netSettlement      Decimal   @default(0) @db.Decimal(14, 2)
  details            Json?
  status             String    @default("DRAFT") @db.VarChar(20) // DRAFT, REVIEWED, APPROVED, CLOSED
  reviewedById       String?   @db.Char(36)
  approvedById       String?   @db.Char(36)
  notes              String?   @db.VarChar(1000)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, status])
  @@map("employee_settlements")
}

// ───────────────────────────── System ─────────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  companyId String?   @db.Char(36)
  userId    String    @db.Char(36)
  type      String    @db.VarChar(60) // translation key suffix, e.g. LEAVE_APPROVED
  params    Json?
  link      String?   @db.VarChar(300)
  channel   String    @default("IN_APP") @db.VarChar(20)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String  @id @default(uuid()) @db.Char(36)
  userId   String  @db.Char(36)
  type     String  @db.VarChar(60)
  inApp    Boolean @default(true)
  email    Boolean @default(false)
  sms      Boolean @default(false)
  whatsapp Boolean @default(false)
  push     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model OutboundMessage {
  id         String    @id @default(uuid()) @db.Char(36)
  companyId  String?   @db.Char(36)
  channel    String    @db.VarChar(20) // EMAIL, SMS, WHATSAPP, PUSH
  recipient  String    @db.VarChar(191)
  subject    String?   @db.VarChar(300)
  body       String    @db.Text
  status     String    @default("QUEUED") @db.VarChar(20) // QUEUED, SENT, FAILED, NOT_CONFIGURED
  error      String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([status])
  @@map("outbound_messages")
}

// Append-only: no update/delete endpoints exist for this table
model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  companyId  String?  @db.Char(36)
  userId     String?  @db.Char(36)
  userName   String?  @db.VarChar(200)
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.Char(36)
  employeeId String?  @db.Char(36)
  oldValue   Json?
  newValue   Json?
  reason     String?  @db.VarChar(500)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(300)
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, employeeId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @db.Char(36)
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@map("system_settings")
}

model Sequence {
  companyId String @db.Char(36)
  name      String @db.VarChar(40)
  value     Int    @default(0)

  @@id([companyId, name])
  @@map("sequences")
}
