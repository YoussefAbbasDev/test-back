  calculationMethod     String    @default("EMPLOYEE_AMOUNT") @db.VarChar(30)
  value                 Decimal?  @db.Decimal(14, 4)
  baseComponentCode     String?   @db.VarChar(40)
  formula               String?   @db.VarChar(500)
