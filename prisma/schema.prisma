// SEEDA HRMS — Prisma schema (MySQL 8 / MariaDB 10.4+)
// Conventions:
//  * Table names are snake_case via @@map; columns are camelCase (companyId == company_id requirement).
//  * Every tenant-owned table carries companyId and is always filtered by it in the service layer.
//  * Money: Decimal(14,2). Days: Decimal(8,2). Rates/percentages: Decimal(9,4).
//  * All DateTime values are stored in UTC. Calendar dates use @db.Date. Company timezone lives on Company.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ───────────────────────────── Core / Tenancy ─────────────────────────────

model Company {
  id                 String    @id @default(uuid()) @db.Char(36)
  code               String    @unique @db.VarChar(40)
  nameAr             String    @db.VarChar(200)
  nameEn             String    @db.VarChar(200)
  logoFileId         String?   @db.Char(36)
  defaultLanguage    String    @default("ar") @db.VarChar(5)
  currency           String    @default("SAR") @db.VarChar(3)
  timezone           String    @default("Asia/Riyadh") @db.VarChar(64)
  country            String    @default("SA") @db.VarChar(2)
  weekendDays        Json // array of dayjs weekday numbers, e.g. [5,6] = Fri, Sat
  workWeekStartsOn   Int       @default(0) // 0 = Sunday
  documentAlertDays  Int       @default(30)
  contractAlertDays  Int       @default(60)
  isDemo             Boolean   @default(false)
  status             String    @default("ACTIVE") @db.VarChar(20)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  branches     Branch[]
  users        User[]
  roles        Role[]
  departments  Department[]
  employees    Employee[]
  payrollSetting PayrollSetting?

  @@map("companies")
}

model Branch {
  id               String    @id @default(uuid()) @db.Char(36)
  companyId        String    @db.Char(36)
  code             String    @db.VarChar(40)
  nameAr           String    @db.VarChar(200)
  nameEn           String    @db.VarChar(200)
  city             String?   @db.VarChar(100)
  address          String?   @db.VarChar(500)
  phone            String?   @db.VarChar(30)
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  managerId        String?   @db.Char(36)
  status           String    @default("ACTIVE") @db.VarChar(20)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  company     Company     @relation(fields: [companyId], references: [id])
  manager     Employee?   @relation("BranchManager", fields: [managerId], references: [id])
  employees   Employee[]  @relation("EmployeeBranch")
  departments Department[]
  locations   AttendanceLocation[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("branches")
}

model User {
  id             String    @id @default(uuid()) @db.Char(36)
  companyId      String?   @db.Char(36) // null only for platform Super Admin
  employeeId     String?   @unique @db.Char(36)
  email          String    @unique @db.VarChar(191)
  passwordHash   String    @db.VarChar(100)
  displayName    String    @db.VarChar(200)
  language       String    @default("ar") @db.VarChar(5)
  status         String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, DISABLED, LOCKED
  isSuperAdmin   Boolean   @default(false)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  passwordChangedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company        Company?  @relation(fields: [companyId], references: [id])
  employee       Employee? @relation(fields: [employeeId], references: [id])
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  notificationPreferences NotificationPreference[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  tokenHash  String    @unique @db.Char(64)
  family     String    @db.Char(36) // rotation family; reuse of a revoked token revokes the whole family
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Char(36)
  ip         String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String?  @db.Char(36) // null = platform role (Super Admin)
  code        String   @db.VarChar(60)
  nameAr      String   @db.VarChar(120)
  nameEn      String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false)
  // Data scope applied to every permission granted by this role:
  // COMPANY, BRANCH, DEPARTMENT, TEAM, ASSIGNED (direct reports), OWN
  dataScope   String   @default("OWN") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Char(36)
  code     String @unique @db.VarChar(100) // e.g. employees.view
  module   String @db.VarChar(50)
  action   String @db.VarChar(30) // view, create, edit, delete, approve, reject, export, print, settings

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Char(36)
  permissionId String @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId   String  @db.Char(36)
  roleId   String  @db.Char(36)
  // Optional narrowing: a BRANCH-scoped role limited to this branch; otherwise the employee's own branch is used
  branchId String? @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ───────────────────────────── Organization ─────────────────────────────

model Department {
  id          String    @id @default(uuid()) @db.Char(36)
  companyId   String    @db.Char(36)
  branchId    String?   @db.Char(36)
  parentId    String?   @db.Char(36)
  // EXECUTIVE (executive management), DEPARTMENT, SECTION
  type        String    @default("DEPARTMENT") @db.VarChar(20)
  code        String    @db.VarChar(40)
  nameAr      String    @db.VarChar(200)
  nameEn      String    @db.VarChar(200)
  description String?   @db.Text
  managerId   String?   @db.Char(36)
  sortOrder   Int       @default(0)
  status      String    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company   Company      @relation(fields: [companyId], references: [id])
  branch    Branch?      @relation(fields: [branchId], references: [id])
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  manager   Employee?    @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[]   @relation("EmployeeDepartment")
  sectionEmployees Employee[] @relation("EmployeeSection")
  teams     Team[]
  positions JobPosition[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@map("departments")
}

model Team {
  id           String    @id @default(uuid()) @db.Char(36)
  companyId    String    @db.Char(36)
  departmentId String    @db.Char(36)
  code         String    @db.VarChar(40)
  nameAr       String    @db.VarChar(200)
  nameEn       String    @db.VarChar(200)
  leaderId     String?   @db.Char(36)
  status       String    @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  department Department @relation(fields: [departmentId], references: [id])
  leader     Employee?  @relation("TeamLeader", fields: [leaderId], references: [id])
  employees  Employee[] @relation("EmployeeTeam")

  @@unique([companyId, code])
  @@map("teams")
}

model JobGrade {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @db.Char(36)
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  level     Int      @default(1)
  minSalary Decimal? @db.Decimal(14, 2)
  maxSalary Decimal? @db.Decimal(14, 2)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions JobPosition[]
  employees Employee[]

  @@unique([companyId, code])
  @@map("job_grades")
}

model JobPosition {
  id                  String    @id @default(uuid()) @db.Char(36)
  companyId           String    @db.Char(36)
  departmentId        String?   @db.Char(36)
  gradeId             String?   @db.Char(36)
  reportsToPositionId String?   @db.Char(36)
  code                String    @db.VarChar(40)
  titleAr             String    @db.VarChar(200)
  titleEn             String    @db.VarChar(200)
  level               Int?
  description         String?   @db.Text
  requiredSkills      String?   @db.Text
  salaryMin           Decimal?  @db.Decimal(14, 2)
  salaryMax           Decimal?  @db.Decimal(14, 2)
  status              String    @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  department Department?   @relation(fields: [departmentId], references: [id])
  grade      JobGrade?     @relation(fields: [gradeId], references: [id])
  reportsTo  JobPosition?  @relation("PositionTree", fields: [reportsToPositionId], references: [id])
  reports    JobPosition[] @relation("PositionTree")
  employees  Employee[]

  @@unique([companyId, code])
  @@map("job_positions")
}

// ───────────────────────────── Employees ─────────────────────────────

model Employee {
  id               String    @id @default(uuid()) @db.Char(36)
  companyId        String    @db.Char(36)
  employeeNumber   String    @db.VarChar(40)
  firstName        String    @db.VarChar(100)
  middleName       String?   @db.VarChar(100)
  lastName         String    @db.VarChar(100)
  fullNameAr       String?   @db.VarChar(250)
  fullNameEn       String?   @db.VarChar(250)
  photoFileId      String?   @db.Char(36)
  gender           String?   @db.VarChar(10)
  dateOfBirth      DateTime? @db.Date
  nationality      String?   @db.VarChar(60)
  maritalStatus    String?   @db.VarChar(20)
  nationalId       String?   @db.VarChar(40)
  passportNumber   String?   @db.VarChar(40)
  passportExpiry   DateTime? @db.Date
  mobile           String?   @db.VarChar(30)
  altMobile        String?   @db.VarChar(30)
  email            String?   @db.VarChar(191)
  country          String?   @db.VarChar(60)
  city             String?   @db.VarChar(100)
  address          String?   @db.VarChar(500)

  // Employment
  branchId         String?   @db.Char(36)
  departmentId     String?   @db.Char(36)
  sectionId        String?   @db.Char(36)
  teamId           String?   @db.Char(36)
  positionId       String?   @db.Char(36)
  gradeId          String?   @db.Char(36)
  managerId        String?   @db.Char(36)
  employmentType   String    @default("FULL_TIME") @db.VarChar(20) // FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN
  contractType     String    @default("LIMITED") @db.VarChar(20)  // LIMITED, UNLIMITED, PROJECT, SEASONAL
  workLocation     String?   @db.VarChar(200)
  hireDate         DateTime  @db.Date
  probationStart   DateTime? @db.Date
  probationEnd     DateTime? @db.Date
  contractStart    DateTime? @db.Date
  contractEnd      DateTime? @db.Date
  noticePeriodDays Int?
  defaultShiftId   String?   @db.Char(36)
  attendancePolicyId String? @db.Char(36)
  salaryStructureId  String? @db.Char(36)
  jobLevel         String?   @db.VarChar(40)
  status           String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, ON_LEAVE, SUSPENDED, PROBATION, RESIGNED, TERMINATED, INACTIVE
  terminationDate  DateTime? @db.Date

  // Financial (salary amounts live in employee_salary_revisions)
  paymentFrequency String    @default("MONTHLY") @db.VarChar(20)
  paymentMethod    String    @default("BANK") @db.VarChar(20) // BANK, CASH, CHEQUE
  bankName         String?   @db.VarChar(120)
  iban             String?   @db.VarChar(34)
  accountHolder    String?   @db.VarChar(200)
  gosiApplicable   Boolean   @default(false)
  gosiNumber       String?   @db.VarChar(40)

  kioskPinHash     String?   @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?
  deletedAt        DateTime?

  company    Company      @relation(fields: [companyId], references: [id])
  branch     Branch?      @relation("EmployeeBranch", fields: [branchId], references: [id])
  department Department?  @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  section    Department?  @relation("EmployeeSection", fields: [sectionId], references: [id])
  team       Team?        @relation("EmployeeTeam", fields: [teamId], references: [id])
  position   JobPosition? @relation(fields: [positionId], references: [id])
  grade      JobGrade?    @relation(fields: [gradeId], references: [id])
  manager    Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports    Employee[]   @relation("EmployeeManager")
  defaultShift Shift?     @relation(fields: [defaultShiftId], references: [id])
  attendancePolicy AttendancePolicy? @relation(fields: [attendancePolicyId], references: [id])
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  user       User?

  managedBranches    Branch[]     @relation("BranchManager")
  managedDepartments Department[] @relation("DepartmentManager")
  ledTeams           Team[]       @relation("TeamLeader")

  emergencyContacts EmployeeEmergencyContact[]
  documents         EmployeeDocument[]
  employmentHistory EmployeeEmploymentHistory[]
  salaryRevisions   EmployeeSalaryRevision[]
  attendanceRecords AttendanceRecord[]
  attendanceEvents  AttendanceEvent[]
  corrections       AttendanceCorrection[]
  shiftAssignments  ShiftAssignment[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  payrollEntries    PayrollRunEmployee[]
  payrollAdjustments PayrollAdjustment[]
  payslips          Payslip[]
  commissionEntries CommissionTransaction[]
  commissionParticipations CommissionParticipant[]
  advances          EmployeeAdvance[]
  loans             EmployeeLoan[]
  installments      Installment[]
  ledgerEntries     FinancialLedgerEntry[]
  settlements       EmployeeSettlement[]
  shiftExchangesRequested ShiftExchangeRequest[] @relation("ExchangeRequester")
  shiftExchangesReplacement ShiftExchangeRequest[] @relation("ExchangeReplacement")

  @@unique([companyId, employeeNumber])
  @@index([companyId, status])
  @@index([companyId, branchId])
  @@index([companyId, departmentId])
  @@index([companyId, managerId])
  @@index([companyId, nationalId])
  @@index([companyId, mobile])
  @@map("employees")
}

model EmployeeEmergencyContact {
  id           String   @id @default(uuid()) @db.Char(36)
  companyId    String   @db.Char(36)
  employeeId   String   @db.Char(36)
  name         String   @db.VarChar(200)
  relationship String   @db.VarChar(60)
  phone        String   @db.VarChar(30)
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

model EmployeeEmploymentHistory {
  id            String   @id @default(uuid()) @db.Char(36)
  companyId     String   @db.Char(36)
  employeeId    String   @db.Char(36)
  // TRANSFER_BRANCH, CHANGE_DEPARTMENT, CHANGE_MANAGER, CHANGE_POSITION, CHANGE_STATUS, CHANGE_CONTRACT, HIRE
  changeType    String   @db.VarChar(40)
  field         String   @db.VarChar(60)
  oldValue      String?  @db.VarChar(250)
  newValue      String?  @db.VarChar(250)
  oldLabel      String?  @db.VarChar(250)
  newLabel      String?  @db.VarChar(250)
  effectiveDate DateTime @db.Date
  reason        String?  @db.VarChar(500)
  changedById   String?  @db.Char(36)
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, employeeId, effectiveDate])
  @@map("employee_employment_history")
}

model EmployeeSalaryRevision {
  id            String   @id @default(uuid()) @db.Char(36)
  companyId     String   @db.Char(36)
  employeeId    String   @db.Char(36)
  effectiveFrom DateTime @db.Date
  reason        String?  @db.VarChar(500)
  status        String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, CANCELLED
  createdById   String?  @db.Char(36)
  createdAt     DateTime @default(now())

  employee Employee                  @relation(fields: [employeeId], references: [id])
  lines    EmployeeSalaryComponent[]

  @@unique([employeeId, effectiveFrom])
  @@index([companyId, employeeId])
  @@map("employee_salary_revisions")
}

model EmployeeSalaryComponent {
  id          String  @id @default(uuid()) @db.Char(36)
  revisionId  String  @db.Char(36)
  componentId String  @db.Char(36)
  amount      Decimal @db.Decimal(14, 2)

  revision  EmployeeSalaryRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  component SalaryComponent        @relation(fields: [componentId], references: [id])

  @@unique([revisionId, componentId])
  @@map("employee_salary_components")
}

model EmployeeDocument {
  id              String    @id @default(uuid()) @db.Char(36)
  companyId       String    @db.Char(36)
  employeeId      String    @db.Char(36)
  // NATIONAL_ID, IQAMA, PASSPORT, CONTRACT, CERTIFICATE, LICENSE, TRAINING, MEDICAL_INSURANCE, OTHER
  type            String    @db.VarChar(30)
  name            String    @db.VarChar(200)
  number          String?   @db.VarChar(80)
  issueDate       DateTime? @db.Date
  expiryDate      DateTime? @db.Date
  alertDaysBefore Int?
  fileId          String?   @db.Char(36)
  status          String    @default("VALID") @db.VarChar(20) // VALID, EXPIRING, EXPIRED, ARCHIVED
  notes           String?   @db.VarChar(1000)
  lastAlertAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  employee Employee        @relation(fields: [employeeId], references: [id])
  file     FileAttachment? @relation(fields: [fileId], references: [id])

  @@index([companyId, expiryDate])
  @@index([employeeId])
  @@map("employee_documents")
}

model FileAttachment {
  id           String   @id @default(uuid()) @db.Char(36)
  companyId    String   @db.Char(36)
  storageKey   String   @unique @db.VarChar(300)
  originalName String   @db.VarChar(300)
  mimeType     String   @db.VarChar(120)
  size         Int
  entityType   String?  @db.VarChar(60)
  entityId     String?  @db.Char(36)
  uploadedById String?  @db.Char(36)
  createdAt    DateTime @default(now())

  documents EmployeeDocument[]

  @@index([companyId, entityType, entityId])
  @@map("file_attachments")
}

// ───────────────────────────── Attendance ─────────────────────────────

model AttendancePolicy {
  id                       String   @id @default(uuid()) @db.Char(36)
  companyId                String   @db.Char(36)
  name                     String   @db.VarChar(150)
  // Resolution order: employee override → department → branch → company default
  scope                    String   @default("COMPANY") @db.VarChar(20)
  branchId                 String?  @db.Char(36)
  departmentId             String?  @db.Char(36)
  isDefault                Boolean  @default(false)
  graceMinutes             Int      @default(10)
  lateCountFromShiftStart  Boolean  @default(true)
  halfDayThresholdMinutes  Int?     // late beyond this → HALF_DAY
  earlyLeaveGraceMinutes   Int      @default(5)
  minWorkingMinutes        Int?     // below → HALF_DAY / INCOMPLETE
  breakMinutes             Int      @default(60)
  overtimeEnabled          Boolean  @default(true)
  overtimeMinMinutes       Int      @default(30)
  overtimeRequiresApproval Boolean  @default(true)
  weekendWorkIsOvertime    Boolean  @default(true)
  holidayWorkIsOvertime    Boolean  @default(true)
  missingCheckoutAction    String   @default("MARK_INCOMPLETE") @db.VarChar(30) // MARK_INCOMPLETE, AUTO_SHIFT_END
  allowMultipleSessions    Boolean  @default(true)
  correctionWindowDays     Int      @default(7)
  correctionRequiresHR     Boolean  @default(false)
  requireGeofence          Boolean  @default(true)
  maxGpsAccuracyMeters     Int      @default(100)
  rejectOutsideGeofence    Boolean  @default(true)
  allowedMethods           Json     // ["GPS","QR","KIOSK","MANUAL","BIOMETRIC","NFC"]
  minMinutesBetweenEvents  Int      @default(1)
  status                   String   @default("ACTIVE") @db.VarChar(20)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  employees Employee[]

  @@index([companyId, scope])
  @@map("attendance_policies")
}

model AttendanceLocation {
  id           String   @id @default(uuid()) @db.Char(36)
  companyId    String   @db.Char(36)
  branchId     String?  @db.Char(36)
  name         String   @db.VarChar(150)
  type         String   @default("BRANCH") @db.VarChar(20) // BRANCH, FIELD, CUSTOMER_SITE
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  radiusMeters Int      @default(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([companyId, branchId])
  @@map("attendance_locations")
}

model AttendanceDevice {
  id          String    @id @default(uuid()) @db.Char(36)
  companyId   String    @db.Char(36)
  branchId    String?   @db.Char(36)
  type        String    @db.VarChar(20) // KIOSK, BIOMETRIC, NFC, FACE, MOBILE
  name        String    @db.VarChar(150)
  serial      String?   @db.VarChar(120)
  apiKeyHash  String?   @db.Char(64)
  apiKeyPrefix String?  @db.VarChar(12)
  status      String    @default("ACTIVE") @db.VarChar(20)
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@map("attendance_devices")
}

model QrToken {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @db.Char(36)
  branchId  String   @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([companyId, branchId, expiresAt])
  @@map("attendance_qr_tokens")
}

model AttendanceRecord {
  id                     String    @id @default(uuid()) @db.Char(36)
  companyId              String    @db.Char(36)
  employeeId             String    @db.Char(36)
  date                   DateTime  @db.Date // local (company timezone) work date
  shiftId                String?   @db.Char(36)
  scheduledStart         DateTime?
  scheduledEnd           DateTime?
  firstCheckIn           DateTime?
  lastCheckOut           DateTime?
  checkInMethod          String?   @db.VarChar(20)
  checkOutMethod         String?   @db.VarChar(20)
  checkInLat             Decimal?  @db.Decimal(10, 7)
  checkInLng             Decimal?  @db.Decimal(10, 7)
  checkOutLat            Decimal?  @db.Decimal(10, 7)
  checkOutLng            Decimal?  @db.Decimal(10, 7)
  checkInLocationId      String?   @db.Char(36)
  checkOutLocationId     String?   @db.Char(36)
  lateMinutes            Int       @default(0)
  earlyLeaveMinutes      Int       @default(0)
  workedMinutes          Int       @default(0)
  breakMinutes           Int       @default(0)
  regularMinutes         Int       @default(0)
  overtimeMinutes        Int       @default(0)
  overtimeApprovedMinutes Int      @default(0)
  overtimeStatus         String    @default("NONE") @db.VarChar(20) // NONE, PENDING, APPROVED, REJECTED
  dayType                String    @default("WORKDAY") @db.VarChar(20) // WORKDAY, WEEKEND, HOLIDAY
  // PRESENT, LATE, ABSENT, HALF_DAY, ON_LEAVE, HOLIDAY, DAY_OFF, INCOMPLETE, PENDING_APPROVAL
  status                 String    @default("INCOMPLETE") @db.VarChar(20)
  approvalStatus         String    @default("NOT_REQUIRED") @db.VarChar(20) // NOT_REQUIRED, PENDING, APPROVED, REJECTED
  isManual               Boolean   @default(false)
  isSuspicious           Boolean   @default(false)
  flags                  Json?
  notes                  String?   @db.VarChar(1000)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id])
  shift    Shift?            @relation(fields: [shiftId], references: [id])
  events   AttendanceEvent[]
  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@index([companyId, status, date])
  @@map("attendance_records")
}

model AttendanceEvent {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  employeeId  String   @db.Char(36)
  recordId    String   @db.Char(36)
  type        String   @db.VarChar(20) // CHECK_IN, CHECK_OUT, BREAK_START, BREAK_END
