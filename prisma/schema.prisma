model LeavePolicy {
  id                       String    @id @default(uuid()) @db.Char(36)
  companyId                String    @db.Char(36)
  leaveTypeId              String    @db.Char(36)
  name                     String    @db.VarChar(150)
  annualEntitlement        Decimal   @default(0) @db.Decimal(8, 2)
  accrualMethod            String    @default("UPFRONT") @db.VarChar(20) // UPFRONT, MONTHLY, NONE
  accrualFrequency         String    @default("YEARLY") @db.VarChar(20)  // YEARLY, MONTHLY
