  notes       String?  @db.VarChar(500)
  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@index([companyId, date])
  @@index([employeeId, startAt, endAt])
  @@map("shift_assignments")
}

model ShiftRotation {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  name        String   @db.VarChar(150)
  type        String   @db.VarChar(20) // WEEKLY, MONTHLY, CUSTOM
  // pattern: array of { shiftId | null } per block; block length = blockDays (7 for WEEKLY, month for MONTHLY, custom days)
  pattern     Json
  blockDays   Int      @default(7)
  startDate   DateTime @db.Date
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shift_rotation_rules")
}

model ShiftExchangeRequest {
  id                      String    @id @default(uuid()) @db.Char(36)
  companyId               String    @db.Char(36)
  requesterId             String    @db.Char(36)
  replacementId           String    @db.Char(36)
  requesterAssignmentId   String    @db.Char(36)
  replacementAssignmentId String?   @db.Char(36) // null = replacement takes the shift without giving one back
  date                    DateTime  @db.Date
  reason                  String?   @db.VarChar(1000)
  replacementConsent      String    @default("PENDING") @db.VarChar(20) // PENDING, ACCEPTED, DECLINED
  status                  String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED, CANCELLED
  approvalInstanceId      String?   @db.Char(36)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  requester   Employee @relation("ExchangeRequester", fields: [requesterId], references: [id])
  replacement Employee @relation("ExchangeReplacement", fields: [replacementId], references: [id])

  @@index([companyId, status])
  @@map("shift_exchange_requests")
}

model ShiftCoverageRequirement {
  id           String   @id @default(uuid()) @db.Char(36)
  companyId    String   @db.Char(36)
  branchId     String   @db.Char(36)
  shiftId      String   @db.Char(36)
