NODE_ENV=development
PORT=4000
# MySQL 8.0+ (or MariaDB 10.4+). Use a dedicated least-privilege user.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/seeda_hrms"
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/seeda_hrms_shadow"
TEST_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/seeda_hrms_test"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
LOG_LEVEL=info
# Demo seed password (development only). Seed refuses to run when NODE_ENV=production.
DEMO_PASSWORD=
# Optional providers (not configured = messages are recorded with status NOT_CONFIGURED)
SMTP_URL=
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
# Per-IP API requests per minute
RATE_LIMIT_PER_MIN=600
